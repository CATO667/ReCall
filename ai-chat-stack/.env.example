# 复制为 .env 后编辑：cp .env.example .env

# LLM（DeepSeek 等 OpenAI 兼容 API）
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY

# 各 gRPC 服务 accessToken（需保持一致）
ACCESS_TOKEN=dev-local-access-token

# Ollama embedding 模型
OLLAMA_MODEL=bge-m3

# 应用容器连接 KV（主库在宿主机时用 host.docker.internal）
KV_WRITE_HOST=host.docker.internal
KV_READ_HOST=host.docker.internal
KV_PORT=2000
KV_READ_PORT=2000

# replication：读从库 VM IP，例如 KV_READ_HOST=192.168.x.y

# 可选：构建后自动拉取 Ollama 模型
OLLAMA_PULL_ON_START=1
