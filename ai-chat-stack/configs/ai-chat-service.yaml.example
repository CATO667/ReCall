server:
  ip: 0.0.0.0
  port: 50051
  accessToken: "dev-local-access-token"
log:
  level: "info"
  logPath: "runtime/logs/app.log"
chat:
  api_key: "YOUR_DEEPSEEK_API_KEY"
  base_url: "https://api.deepseek.com/v1"
  model: "deepseek-v4-flash"
  max_tokens: 32768
  temperature: 0.8
  top_p: 0.9
  presence_penalty: 0.8
  frequency_penalty: 0.5
  bot_desc: "你是一个AI助手，我需要你模拟一名资深的软件工程师来回答我的问题"
  min_response_tokens: 2048
  context_ttl: 1800
  context_len: 4
  qa_cache_ttl: 0
kvstore:
  write_host: "127.0.0.1"
  read_host: "127.0.0.1"
  port: 2000
  read_port: 2000
  prefix: "ai_chat_service_"
embedder:
  provider: "openai_compat"
  api_key: "ollama"
  base_url: "http://127.0.0.1:11434/v1"
  model: "bge-m3"
vector:
  enabled: true
  provider: "kvstore"
  collection: "ai_chat_qa"
  vector_dim: 1024
  recall_top_k: 20
  similarity_threshold: 0.4
  cache_similarity_threshold: 0.65
  qa_score_boost: 0.05
  topic_similarity_threshold: 0.82
  orchestration_v2: true
  top_k: 3
kbase:
  enabled: true
  collection: "ai_chat_docs"
  chunk_strategy: "record"
  chunk_size: 512
  chunk_overlap: 64
  min_chunk_size: 50
  embed_concurrency: 2
  similarity_threshold: 0.4
  hybrid_enabled: true
  hybrid_vector_weight: 0.65
  hybrid_keyword_weight: 0.35
  rerank_enabled: true
  rerank_keyword_boost: 0.08
dependOn:
  sensitive:
    address: "sensitive:50051"
    accessToken: "dev-local-access-token"
  keywords:
    address: "keywords:50051"
    accessToken: "dev-local-access-token"
  tokenizer:
    address: "http://tokenizer:3002"
