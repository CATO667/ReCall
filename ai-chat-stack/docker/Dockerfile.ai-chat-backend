FROM golang:1.22-bookworm AS builder

ENV GOPROXY=https://goproxy.cn,direct
WORKDIR /src/ai-chat-backend
COPY ai-chat-backend/go.mod ai-chat-backend/go.sum ./
RUN go mod download
COPY ai-chat-backend/ .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/ai-chat-backend ./cmd/

FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /out/ai-chat-backend ./ai-chat-backend
COPY ai-chat-backend/www ./www

ENTRYPOINT ["./ai-chat-backend"]
CMD ["--config=/app/config.yaml"]
